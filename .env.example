# Crossrail environment variables.
# docker compose supplies working values for all of these; copy to .env only for local
# development outside Docker (yarn start:dev) or to override a default.

# HTTP port the API listens on
PORT=3000

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=crossrail
DB_PASSWORD=crossrail
DB_NAME=crossrail

# Host port that docker compose publishes Postgres on (container port is always 5432).
# Change this if something else already listens on 5432 on your machine.
POSTGRES_PORT=5432

# Live FX provider: any free, keyless JSON API returning USD-based rates as { "rates": { "NGN": ... } }
FX_PROVIDER_URL=https://open.er-api.com/v6/latest/USD
# Timeout for the live FX call in milliseconds; on timeout, rates fall back to fx_rates, then the in-code FALLBACK_RATES
FX_TIMEOUT_MS=3000

